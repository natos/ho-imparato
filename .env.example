# Copy to .env.local for local dev. All optional locally (embedded DB, open signup).
# On Vercel set these in Project → Settings → Environment Variables.

# Neon Postgres (added automatically when you connect Neon in the Vercel Marketplace)
DATABASE_URL=

# Long random string: openssl rand -base64 32
SESSION_SECRET=

# Shared code new players must enter to sign up
INVITE_CODE=

# Passkeys are bound to ONE domain. Production values, e.g.:
# RP_ID=ho-imparato.vercel.app
# RP_ORIGIN=https://ho-imparato.vercel.app
RP_ID=
RP_ORIGIN=

# Vercel Blob (added automatically when you connect a Blob store: either
# BLOB_READ_WRITE_TOKEN, or BLOB_STORE_ID with OIDC on newer stores)
BLOB_READ_WRITE_TOKEN=

# Sentioo feedback widget (optional; no key = no widget). The key is the snt_… key from
# the Sentioo dashboard > Settings. It is public by design (it ships in the page).
# Until Sentioo production is live, point at staging:
# NEXT_PUBLIC_SENTIOO_WIDGET_URL=https://app-staging.sentioo.io/sentioo-widget.js
# NEXT_PUBLIC_SENTIOO_API_URL=https://posta-staging.sentioo.io
NEXT_PUBLIC_SENTIOO_KEY=
NEXT_PUBLIC_SENTIOO_WIDGET_URL=
NEXT_PUBLIC_SENTIOO_API_URL=
